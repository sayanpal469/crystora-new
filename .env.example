# Public site origin — used for canonical URLs, sitemap.xml, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://crystaura.co.in

# Backend API used by the browser (cart, checkout, auth, orders…).
# Defaults: http://localhost:8000/api in dev, the Hostinger backend in production builds.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Optional: backend API used during server rendering. Point it at an internal
# address when the Next.js server runs next to the backend. Defaults to the value above.
# API_BASE_URL=http://127.0.0.1:8000/api

# Optional: Meta Pixel id (defaults to the existing Crystaura pixel).
# NEXT_PUBLIC_META_PIXEL_ID=966376123062272
